DEEPGRAM_API_KEY=your_deepgram_api_key
# anthropic uses Deepgram's Claude. openai sends think calls to your key. google is the fallback.
THINK_PROVIDER=anthropic
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
USE_ELEVENLABS=false
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_token
DATABASE_URL=postgresql://user:password@host:5432/salon
JWT_SECRET=generate_a_long_random_string
RESEND_API_KEY=re_your_resend_key
RESEND_FROM=Kesh Kala <onboarding@resend.dev>
# Gmail sends the sign-in code to any address. Leave SMTP_HOST empty to use Resend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=Kesh Kala <your@gmail.com>
CORS_ORIGINS=http://localhost:3000
